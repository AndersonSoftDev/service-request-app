# Copy this file to .env.local and replace the values with your own provider's
# public configuration. VITE_ variables are bundled into the browser build, so
# they are public configuration and must never hold a client secret or token.

# Issuer URL, including the realm/tenant path when the provider requires one.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/your-realm

# Public SPA client registered for Authorization Code + PKCE (no client secret).
VITE_OIDC_CLIENT_ID=your-public-client-id

# Must be this application's own origin; the paths are fixed by the router.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# Base URL of the Service Request API. Intentionally empty and unused: the real
# API was not available, so the app runs against the in-memory mock service.
VITE_API_BASE_URL=
